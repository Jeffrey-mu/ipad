<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		2.5.0：改成显式 Filter。
		之前用「不带 Filter = 注入所有进程」，但 roothide 的加载器可能只认显式列表，
		结果就是哪儿都没注入（现象完全吻合）。
		com.juzi.balls = 球球大作战
		org.coolstar.SileoStore = Sileo（对照组，验证注入链路是否通）
	-->
	<key>Filter</key>
	<dict>
		<key>Bundles</key>
		<array>
			<string>com.juzi.balls</string>
			<string>org.coolstar.SileoStore</string>
		</array>
	</dict>
</dict>
</plist>
