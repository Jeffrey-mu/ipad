<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		2.7.0：只注入球球大作战。
		之前 Filter 里带了 Sileo，结果把 Sileo 也卡死了，先去掉，
		出问题也只影响游戏，不影响你卸载/装包。
	-->
	<key>Filter</key>
	<dict>
		<key>Bundles</key>
		<array>
			<string>com.juzi.balls</string>
		</array>
	</dict>
</dict>
</plist>
